# Copy to .env and set a read/write API key for the intended cluster.
RAWTREE_API_KEY=
RAWTREE_BASE_URL=https://api.rawtree.com
RAWTREE_DATABASE=default
RAWTREE_TABLE=continuum_checkpoints_v1

# Optional local Liquid server (OpenAI-compatible, localhost only). When set, OpenRouter is not used.
# Example: LIQUID_BASE_URL=http://127.0.0.1:8080/v1 and LIQUID_MODEL=LFM2.5-2.6B-Q4_K_M (must equal the served alias).
LIQUID_BASE_URL=

# Hosted Liquid inference through OpenRouter.
OPENROUTER_API_KEY=
LIQUID_MODEL=liquid/lfm-2.5-2.6b:free
# Conservative local UTC-day inference attempt cap (all runs in this workspace).
OPENROUTER_DAILY_REQUEST_CAP=10

NIMBLE_API_KEY=

NIMBLE_DAILY_REQUEST_CAP=4

NIMBLE_DAILY_COST_CAP_USD=0.02

# Optional tuning (defaults shown).
# RAWTREE_FLIGHT_TABLE=continuum_flight_v1
# NIMBLE_PAGES_PER_TASK=1          # full-page fallback fetches per task; 0 disables
# CONTINUUM_MAX_FOLLOW_UPS=3       # contradiction-driven follow-up tasks per run
# LIQUID_THINKING_BUDGET=0         # 0-1536 reasoning tokens for local Liquid
# INSPECTOR_PORT=4700

# FLUX media for the evidence brief (Black Forest Labs). Leave empty to skip media.
BFL_API_KEY=
FLUX_IMAGE_BUDGET_USD=0.25
FLUX_VIDEO_BUDGET_USD=0
